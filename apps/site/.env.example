# Public URL of the deployed site (canonical/OG metadata)
NEXT_PUBLIC_SITE_URL=https://sderosiaux.github.io/missura
# Set by pages.yml for project-page deploys; empty for custom domain/local
NEXT_PUBLIC_BASE_PATH=
# Waitlist form target: any endpoint accepting POST {email, source}
# (provider form endpoint, Zapier/Make webhook, or a worker). Form is
# disabled with an honest note when unset.
NEXT_PUBLIC_WAITLIST_ENDPOINT=
